# Google OAuth2 Credentials
# Obtido no Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Google Ads Developer Token
# Obtido em: Google Ads Manager → Ferramentas → API Center
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here

# OAuth2 Refresh Token (gerado automaticamente pelo setup UI)
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here

# Customer ID da conta Google Ads do cliente (sem hífens)
# Formato original: xxx-xxx-xxxx → usar: xxxxxxxxxx
GOOGLE_ADS_CUSTOMER_ID=your_customer_id_here

# Login Customer ID (ID da conta Manager/MCC da Velo)
# Necessário apenas para acesso via Manager Account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_mcc_customer_id_here

# Modo de conta: true para conta de teste, false para produção
GOOGLE_ADS_TEST_ACCOUNT=false
